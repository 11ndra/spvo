# Canonical line endings for the repository.
# Keep text files LF on every platform; GitHub Pages and Linux lab tooling use LF natively.
* text=auto eol=lf

# Explicit text formats used by the course.
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf

# Binary artifacts must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
